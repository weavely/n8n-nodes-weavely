{
    "name": "n8n-nodes-weavely",
    "version": "0.1.1",
    "description": "n8n community node for Weavely form submission triggers",
    "license": "MIT",
    "homepage": "https://github.com/weavely/n8n-nodes-weavely.git#readme",
    "keywords": [
        "n8n-community-node-package",
        "n8n",
        "weavely",
        "forms",
        "webhooks"
    ],
    "author": {
        "name": "Weavely",
        "email": "developer@weavely.ai"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/weavely/n8n-nodes-weavely.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/WeavelyApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/WeavelyTrigger/WeavelyTrigger.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
